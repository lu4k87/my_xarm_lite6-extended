<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rviz_object_distance_visualizer</name>
  <version>0.0.0</version>
  <description>Visualizes a line and distance text from the robot gripper to the nearest YOLO detected object in RViz2</description>
  <maintainer email="lu4k87@live.de">mk</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>rviz_2d_overlay_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

