<?xml version="1.0"?>
<robot name="lite6">
  <material name="White">
    <color rgba="0.9 0.92 0.94 1.0"/>
  </material>
  <material name="Silver">
    <color rgba="0.75 0.77 0.8 1.0"/>
  </material>
  <material name="DarkGrey">
    <color rgba="0.2 0.22 0.25 1.0"/>
  </material>

  <link name="world"/>

  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="link_base"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>

  <!-- Base Link -->
  <link name="link_base">
    <visual>
      <geometry>
        <mesh filename="lite6/visual/link_base.stl"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="White"/>
    </visual>
  </link>

  <!-- Joint 1 & Link 1 -->
  <joint name="joint1" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 0.2435"/>
    <parent link="link_base"/>
    <child link="link1"/>
    <axis xyz="0 0 1"/>
    <limit effort="50.0" lower="-6.2831853" upper="6.2831853" velocity="3.14"/>
  </joint>

  <link name="link1">
    <visual>
      <geometry>
        <mesh filename="lite6/visual/link1.stl"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="White"/>
    </visual>
  </link>

  <!-- Joint 2 & Link 2 -->
  <joint name="joint2" type="revolute">
    <origin rpy="1.5708 -1.5708 3.1416" xyz="0 0 0"/>
    <parent link="link1"/>
    <child link="link2"/>
    <axis xyz="0 0 1"/>
    <limit effort="50.0" lower="-2.61799" upper="2.61799" velocity="3.14"/>
  </joint>

  <link name="link2">
    <visual>
      <geometry>
        <mesh filename="lite6/visual/link2.stl"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="White"/>
    </visual>
  </link>

  <!-- Joint 3 & Link 3 -->
  <joint name="joint3" type="revolute">
    <origin rpy="-3.1416 0 1.5708" xyz="0.2002 0 0"/>
    <parent link="link2"/>
    <child link="link3"/>
    <axis xyz="0 0 1"/>
    <limit effort="32.0" lower="-0.061087" upper="5.235988" velocity="3.14"/>
  </joint>

  <link name="link3">
    <visual>
      <geometry>
        <mesh filename="lite6/visual/link3.stl"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="White"/>
    </visual>
  </link>

  <!-- Joint 4 & Link 4 -->
  <joint name="joint4" type="revolute">
    <origin rpy="1.5708 0 0" xyz="0.087 -0.22761 0"/>
    <parent link="link3"/>
    <child link="link4"/>
    <axis xyz="0 0 1"/>
    <limit effort="32.0" lower="-6.2831853" upper="6.2831853" velocity="3.14"/>
  </joint>

  <link name="link4">
    <visual>
      <geometry>
        <mesh filename="lite6/visual/link4.stl"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="White"/>
    </visual>
  </link>

  <!-- Joint 5 & Link 5 -->
  <joint name="joint5" type="revolute">
    <origin rpy="1.5708 0 0" xyz="0 0 0"/>
    <parent link="link4"/>
    <child link="link5"/>
    <axis xyz="0 0 1"/>
    <limit effort="32.0" lower="-2.1642" upper="2.1642" velocity="3.14"/>
  </joint>

  <link name="link5">
    <visual>
      <geometry>
        <mesh filename="lite6/visual/link5.stl"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="White"/>
    </visual>
  </link>

  <!-- Joint 6 & Link 6 -->
  <joint name="joint6" type="revolute">
    <origin rpy="-1.5708 0 0" xyz="0 0.0625 0"/>
    <parent link="link5"/>
    <child link="link6"/>
    <axis xyz="0 0 1"/>
    <limit effort="20.0" lower="-6.2831853" upper="6.2831853" velocity="3.14"/>
  </joint>

  <link name="link6">
    <visual>
      <geometry>
        <mesh filename="lite6/visual/link6.stl"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="Silver"/>
    </visual>
  </link>

  <!-- End Effector & Vacuum Gripper -->
  <joint name="joint_eef" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="link6"/>
    <child link="link_eef"/>
  </joint>
  <link name="link_eef"/>

  <joint name="vacuum_gripper_fix" type="fixed">
    <parent link="link_eef"/>
    <child link="uflite_vacuum_gripper_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>

  <link name="uflite_vacuum_gripper_link">
    <visual>
      <geometry>
        <mesh filename="vacuum_gripper/lite/visual/vacuum_gripper_lite.stl"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="DarkGrey"/>
    </visual>
  </link>

  <joint name="joint_tcp" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.061"/>
    <parent link="uflite_vacuum_gripper_link"/>
    <child link="link_tcp"/>
  </joint>
  <link name="link_tcp"/>
</robot>
