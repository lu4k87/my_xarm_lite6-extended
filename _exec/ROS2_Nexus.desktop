# DIESE DATEI NICHT DIREKT NUTZEN!
# ─────────────────────────────────────────────────────────────────
# Stattdessen einmalig install_app.sh ausführen:
#
#   cd ~/dev_ws/_exec && bash install_app.sh
#
# install_app.sh generiert die .desktop-Datei automatisch mit dem
# korrekten Benutzerpfad für diesen PC und registriert die App
# im Ubuntu App-Menü.
# ─────────────────────────────────────────────────────────────────

[Desktop Entry]
Name=ROS 2 Nexus
Comment=ROS 2 Workspace Manager — Web Edition
Exec=WIRD_VON_install_app.sh_GENERIERT
Icon=WIRD_VON_install_app.sh_GENERIERT
Terminal=false
Type=Application
Categories=Development;Science;
StartupNotify=true
StartupWMClass=ros2-nexus
